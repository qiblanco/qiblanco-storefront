SESSION_SECRET=replace-with-a-preview-only-secret

# Approved Shopify Storefront API values. Never commit real values.
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=
PUBLIC_CHECKOUT_DOMAIN=

# Keep tracking and the existing Gorgias widget disabled on the preview host.
PUBLIC_ENABLE_TRACKING_IN_PREVIEW=false

# New Salesbot widget. Local example shown; use the public Hetzner URL on Vercel.
PUBLIC_SALESBOT_WIDGET_ENABLED=true
PUBLIC_SALESBOT_WIDGET_ORIGIN=http://localhost:3001
PUBLIC_SALESBOT_WIDGET_TENANT_ID=tenant_qiblanco
PUBLIC_SALESBOT_WIDGET_PROJECT_ID=project_qiblanco_sales
PUBLIC_SALESBOT_WIDGET_PRODUCT_KEY=
PUBLIC_SALESBOT_WIDGET_PLACEMENT=right
PUBLIC_SALESBOT_WIDGET_Z_INDEX=2147483000
PUBLIC_SALESBOT_WIDGET_INITIAL_OPEN=false
